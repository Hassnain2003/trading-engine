# Copy to .env and fill in values. .env is never committed.

# ── Venue (demo-only default) ──────────────────────────────────────────
# The engine connects to Bybit's demo/sandbox venue by default. Never set
# these to point at mainnet unless you have read the mainnet interlock below.
BYBIT_DEMO=true

# Bybit API credentials for the DEMO venue only. Leave blank to run the
# engine/replay without any live connection (order placement is disabled
# unless ENABLE_TRADING=true).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_UID=

# ── Mainnet interlock (safe-by-default) ────────────────────────────────
# Mainnet startup is REFUSED unless BOTH are set. Demo/sandbox needs neither.
# ALLOW_MAINNET=true
# I_UNDERSTAND_THE_RISK=yes

# Trading is disabled by default. Uncomment to allow the engine to place new
# orders (demo venue only; mainnet still requires the two flags above).
# ENABLE_TRADING=true

# ── Risk / execution (config.yaml values, env-overridable) ─────────────
LEVERAGE=5
# LIMIT_OFFSET_PCT=0.0004
# PENDING_ORDER_TTL_SEC=600
# POLL_INTERVAL_SEC=60

# Phase identity (neutral defaults; real values come from these env vars)
# PHASE_ID=demo_phase
# PHASE_LABEL=Demo phase — paper trading
# STARTING_EQUITY=0.0

# ── Alerts (optional; all read from env, never hardcoded) ──────────────
# Primary alerts — ntfy push (recommended, works without VPN)
NTFY_TOPIC=<your-secret-topic>

# Optional: Discord webhook URL
DISCORD_WEBHOOK_URL=

# Optional email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
